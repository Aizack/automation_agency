# Google AI Studio API Key (Para el bot Gemini)
# Puedes obtenerla gratis en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_clave_de_google_aqui

# Configuración de Base de Datos (Local Docker / Producción)
DATABASE_URL=postgres://agency_user:agency_pass@localhost:5432/agency_db

# Entorno
NODE_ENV=development

# Configuración de Almacenamiento en Nube Cloudflare R2 (Opcional - S3 Compatible)
# R2_ACCOUNT_ID=tu_account_id_de_cloudflare
# R2_ACCESS_KEY_ID=tu_access_key_id
# R2_SECRET_ACCESS_KEY=tu_secret_access_key
# R2_BUCKET_NAME=tenant-receipts
# R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev